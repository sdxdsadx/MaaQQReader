# Python / 工具缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# 打包产物（scripts\build-gui-exe.cmd 用命令行参数调用 PyInstaller，不依赖 .spec）
build/
dist/
*.spec
*.exe

# 运行数据与本机配置
runtime/
configs/*.local.json

# 手工备份（备份改用 Git 提交/分支）
_backup_*/
*.bak
*.bak-*
*.orig

# 本机 agent / 工具目录
.hermes/
.serena/

# MFAAvalonia：只入库 interface.json、resource/、agent/；程序文件、config/、debug/、logs/ 等忽略
mfa/*
!mfa/interface.json
!mfa/resource/
!mfa/agent/
